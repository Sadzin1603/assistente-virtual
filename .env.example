# Configurações do Jarvis. Tire o # da frente de uma linha para mudar o padrão.

# --- Inteligência artificial (opcional, gratuita)
# auto = usa a Groq se houver chave abaixo; senão a IA local (Ollama)
# IA_PROVEDOR=auto
# Chave grátis da Groq (console.groq.com). Deixe vazio para usar só a IA local.
GROQ_API_KEY=
# Modelo. Local: qwen2.5:3b (padrão), llama3.2:3b (mais leve), qwen2.5:7b (melhor, mais lento)
# IA_MODELO=qwen2.5:3b
# Para desligar a IA: IA_PROVEDOR=nenhum

# --- Palavra de ativação
# WAKE_PALAVRA=jarvis
# WAKE_LIMIAR=0.5
# WAKE_TRANSCRICAO=1

# --- Voz
# WHISPER_MODELO=small
# PIPER_VOZ=pt_BR-faber-medium

# --- Interface e atualização
# HUD=1
# AUTO_ATUALIZAR=1
